---
import Base from "../layouts/Base.astro";
import { Picture } from "astro:assets";
import welcome from "../assets/photos/welcome-neighbors.jpg";
import { agent, leadsEndpoint } from "../data/site";

const field =
  "mt-1.5 w-full rounded-lg border border-rule bg-card px-3.5 py-2.5 text-base outline-none focus:border-ink focus:ring-2 focus:ring-ink/10";
const checkbox = "mt-0.5 h-5 w-5 shrink-0 cursor-pointer accent-brand";
---

<Base
  title="Stay in Touch | Scott Scharl — Keller Williams Metro"
  description="Join Scott Scharl's list for neighborhood event invites, honest market updates, homeowner tips and local favorites around Royal Oak, Berkley, Clawson and Metro Detroit."
>
  <section class="container-px mx-auto max-w-6xl py-16 sm:py-24">
    <div class="mx-auto max-w-2xl">
      <Picture
        src={welcome}
        formats={["avif", "webp"]}
        widths={[600, 900, 1400]}
        sizes="(min-width: 768px) 672px, 100vw"
        alt="A hand-lettered “Welcome, Neighbors!” sign taped to a wooden post in a Royal Oak park"
        class="aspect-[2/1] w-full rounded-2xl object-cover"
        pictureAttributes={{ class: "block" }}
      />

      <h1 class="mt-10 text-center text-4xl font-semibold tracking-tight sm:text-5xl">Stay in touch, neighbor.</h1>
      <p class="mt-5 text-center text-lg leading-relaxed text-ink/80">
        Get invites to neighborhood get-togethers like our food truck nights and Pumpkinfest, plus honest market
        updates, homeowner tips and my favorite local spots around Royal Oak, Berkley, Clawson and Metro Detroit.
      </p>
      <p class="mt-3 text-center text-muted">A few notes a season, never a flood. Unsubscribe anytime.</p>

      <div id="form-sent" class="mt-10 hidden rounded-2xl border border-rule bg-card p-8 text-center" role="status">
        <h2 class="text-2xl font-semibold tracking-tight">You're on the list!</h2>
        <p class="mt-2 text-muted">Keep an eye out for the next neighborhood invite. See you around!</p>
      </div>

      <form
        id="signup-form"
        method="post"
        action={leadsEndpoint}
        class="mt-10 space-y-5 rounded-2xl border border-rule bg-card p-6 shadow-sm sm:p-8"
      >
        <label class="block text-sm font-medium">Your name<input name="name" required autocomplete="name" class={field} /></label>
        <label class="block text-sm font-medium"
          >Email<input name="contact" type="email" required autocomplete="email" class={field} /></label
        >

        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="email_ok" value="yes" required class={checkbox} />
          <span>
            <span class="font-medium">Yes, email me Scott's updates and event invites.</span>
            <span class="text-muted">I can unsubscribe anytime.</span>
          </span>
        </label>

        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="mail_ok" value="yes" class={checkbox} />
          <span>
            <span class="font-medium">Also mail me</span>
            <span class="text-muted">
              seasonal event postcards, holiday pop-bys, a list of trusted local home pros and the occasional
              neighborhood guide. <span class="text-muted/80">(optional)</span>
            </span>
          </span>
        </label>

        <label id="address-field" class="hidden text-sm font-medium">
          Mailing address
          <input
            name="address"
            autocomplete="street-address"
            placeholder="123 Main St, Royal Oak, MI 48067"
            class={field}
          />
        </label>

        <!-- Spam trap: hidden from people, filled in by bots. -->
        <div class="hidden" aria-hidden="true">
          <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="topic" value="Newsletter" />
        <input type="hidden" name="form" value="newsletter" />
        <input type="hidden" name="source" />
        <input type="hidden" name="t" />
        <input type="hidden" name="page" />

        <p id="form-error" class="hidden rounded-lg bg-brand/10 px-4 py-3 text-sm" role="alert">
          Sorry, that didn't go through. Please text me at
          <a href={agent.sms} class="font-semibold underline">{agent.phoneDisplay}</a> and I'll add you.
        </p>

        <button
          type="submit"
          class="w-full rounded-full bg-brand px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark disabled:opacity-60"
          >Count me in</button
        >
        <p class="text-center text-xs leading-relaxed text-muted">
          Your info stays with me. I never sell or share it. Emails come from {agent.name}, {agent.brokerage}.
        </p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById("signup-form") as HTMLFormElement;
    const sent = document.getElementById("form-sent")!;
    const error = document.getElementById("form-error")!;
    const button = form.querySelector("button")!;
    const label = button.textContent;
    const params = new URLSearchParams(location.search);
    const mailOk = form.elements.namedItem("mail_ok") as HTMLInputElement;
    const addressField = document.getElementById("address-field")!;
    const address = form.elements.namedItem("address") as HTMLInputElement;

    const showSent = () => {
      form.classList.add("hidden");
      sent.classList.remove("hidden");
    };

    // The mailing address only matters (and is only required) if they want postal mail.
    const syncAddress = () => {
      addressField.classList.toggle("hidden", !mailOk.checked);
      addressField.classList.toggle("block", mailOk.checked);
      address.required = mailOk.checked;
    };
    mailOk.addEventListener("change", syncAddress);
    syncAddress();

    // Where the signup came from, e.g. /stay-in-touch?src=postcard
    (form.elements.namedItem("source") as HTMLInputElement).value = params.get("src") ?? document.referrer;
    (form.elements.namedItem("t") as HTMLInputElement).value = String(Date.now());
    (form.elements.namedItem("page") as HTMLInputElement).value = location.pathname;
    if (params.has("sent")) showSent();
    if (params.has("error")) error.classList.remove("hidden");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.classList.add("hidden");
      button.disabled = true;
      button.textContent = "Adding you…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        showSent();
      } catch {
        error.classList.remove("hidden");
        button.disabled = false;
        button.textContent = label;
      }
    });
  </script>
</Base>
