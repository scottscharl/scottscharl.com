---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { agent, leadsEndpoint } from "../data/site";

const topics = ["Buying", "Selling", "Investing", "Renting", "Just have a question"];

const field =
  "mt-1.5 w-full rounded-lg border border-rule bg-card px-3.5 py-2.5 text-base outline-none focus:border-ink focus:ring-2 focus:ring-ink/10";
---

<Base
  title="Contact | Scott Scharl — Keller Williams Metro"
  description="Get in touch with Scott Scharl, REALTOR® at Keller Williams Metro in Royal Oak."
>
  <section class="container-px mx-auto max-w-6xl py-16 sm:py-24">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-center text-4xl font-semibold tracking-tight sm:text-5xl">Say hi.</h1>
      <p class="mt-4 text-center text-lg text-muted">Text, call or email, whatever's easiest. I'll get back to you as soon as I can.</p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {
          [
            { href: agent.sms, icon: "message", label: "Text", value: agent.phoneDisplay },
            { href: `tel:${agent.phone}`, icon: "phone", label: "Call", value: agent.phoneDisplay },
            { href: `mailto:${agent.email}`, icon: "mail", label: "Email", value: agent.email },
          ].map((c) => (
            <li>
              <a
                href={c.href}
                class="flex h-full flex-col items-center rounded-2xl border border-rule bg-card p-5 text-center transition-colors hover:border-brand/50"
              >
                <Icon name={c.icon} class="h-5 w-5 text-brand" />
                <span class="mt-3 font-semibold">{c.label}</span>
                <span class="mt-0.5 break-words text-sm text-muted">{c.value}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-14 text-center text-2xl font-semibold tracking-tight">Or send me a note</h2>

      <div id="form-sent" class="mt-6 hidden rounded-2xl border border-rule bg-card p-8 text-center" role="status">
        <h2 class="text-2xl font-semibold tracking-tight">Thanks — got it.</h2>
        <p class="mt-2 text-muted">I'll get back to you as soon as I can. Talk soon!</p>
      </div>

      <form id="contact-form" method="post" action={leadsEndpoint} class="mt-6 space-y-5">
        <label class="block text-sm font-medium">Your name<input name="name" required autocomplete="name" class={field} /></label>
        <label class="block text-sm font-medium"
          >Best phone or email<input name="contact" required autocomplete="email" class={field} /></label
        >
        <label class="block text-sm font-medium">
          I'm thinking about
          <select name="topic" class={field}>
            {topics.map((t) => <option>{t}</option>)}
          </select>
        </label>
        <label class="block text-sm font-medium">
          Anything I should know? <span class="font-normal text-muted">(optional)</span>
          <textarea name="message" rows="4" class={field}></textarea>
        </label>

        <!-- Spam trap: hidden from people, filled in by bots. -->
        <div class="hidden" aria-hidden="true">
          <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="source" />
        <input type="hidden" name="form" value="contact" />
        <input type="hidden" name="t" />
        <input type="hidden" name="page" />

        <p id="form-error" class="hidden rounded-lg bg-brand/10 px-4 py-3 text-sm" role="alert">
          Sorry, that didn't go through. Please text me at
          <a href={agent.sms} class="font-semibold underline">{agent.phoneDisplay}</a> instead.
        </p>

        <button
          type="submit"
          class="w-full rounded-full bg-brand px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark disabled:opacity-60"
          >Send</button
        >
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const sent = document.getElementById("form-sent")!;
    const error = document.getElementById("form-error")!;
    const button = form.querySelector("button")!;
    const params = new URLSearchParams(location.search);

    const showSent = () => {
      form.classList.add("hidden");
      sent.classList.remove("hidden");
    };

    // Where the lead came from, e.g. /contact?src=billboard-troy
    (form.elements.namedItem("source") as HTMLInputElement).value = params.get("src") ?? document.referrer;
    // Pre-select the topic when coming from a "Who I help" box, e.g. /contact?topic=Buying
    const topic = form.elements.namedItem("topic") as HTMLSelectElement;
    const preset = params.get("topic");
    if (preset && [...topic.options].some((o) => o.value === preset)) topic.value = preset;
    (form.elements.namedItem("t") as HTMLInputElement).value = String(Date.now());
    (form.elements.namedItem("page") as HTMLInputElement).value = location.pathname;
    if (params.has("sent")) showSent();
    if (params.has("error")) error.classList.remove("hidden");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.classList.add("hidden");
      button.disabled = true;
      button.textContent = "Sending…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        showSent();
      } catch {
        error.classList.remove("hidden");
        button.disabled = false;
        button.textContent = "Send";
      }
    });
  </script>
</Base>
