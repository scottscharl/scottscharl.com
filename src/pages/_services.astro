---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { services } from "../data/site";
---

<Base
  title="Services | Scott Scharl — Keller Williams Metro"
  description="Help buying, selling, renting and investing in Metro Detroit from Scott Scharl, REALTOR® with Keller Williams Metro."
>
  <section class="container-px mx-auto max-w-6xl py-16 sm:py-24">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Services</h1>
      <p class="mt-4 text-lg text-muted">
        Whatever your next move, I'll make sure you understand your options before you decide anything.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        services.map((s) => (
          <article
            id={s.slug}
            class="flex scroll-mt-24 flex-col rounded-2xl border border-rule bg-card p-7 shadow-sm sm:p-8"
          >
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-brand/10 text-brand">
              <Icon name={s.icon} class="h-6 w-6" />
            </div>
            <h2 class="mt-6 text-2xl font-semibold tracking-tight">{s.title}</h2>
            <p class="mt-2 text-muted">{s.short}</p>
            <ul class="mt-6 space-y-3 border-t border-rule pt-6">
              {s.points.map((p) => (
                <li class="flex items-start gap-3 text-[15px]">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Base>
