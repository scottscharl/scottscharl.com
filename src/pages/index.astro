---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { agent, contactCta, priceCta, services, reviews } from "../data/site";
---

<Base
  title="Scott Scharl | Home is waiting. — Keller Williams Metro, Royal Oak"
  description="Scott Scharl, REALTOR® with Keller Williams Metro in Royal Oak, helps buyers, sellers and renters across Metro Detroit."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="container-px relative mx-auto flex min-h-[78svh] max-w-4xl flex-col items-center justify-center py-20 text-center sm:py-28"
    >
      <img
        src={agent.photo}
        alt={agent.name}
        class="h-44 w-44 rounded-full bg-stone-100 object-cover shadow-lg shadow-black/10 sm:h-52 sm:w-52"
        width="208"
        height="208"
        fetchpriority="high"
      />
      <h1 class="mt-10 text-5xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-7xl">
        {agent.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
        Navigate today's market with a trusted advisor.
      </p>
      <div class="mt-10 flex flex-col items-center gap-5 sm:flex-row sm:gap-8">
        <a
          href={contactCta.href}
          class="rounded-full bg-brand px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand/20 transition-colors hover:bg-brand-dark"
          >{contactCta.label}</a
        >
        <a href={priceCta.href} class="inline-flex items-center gap-1.5 text-sm font-semibold hover:text-brand">
          {priceCta.label}
          <Icon name="arrow" class="h-4 w-4 text-brand" />
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-t border-rule bg-sand/60">
    <div class="container-px mx-auto max-w-6xl py-16 sm:py-20">
      <h2 class="text-center text-3xl font-semibold tracking-tight">Who I help</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <a
              href={s.href}
              class="group flex flex-col items-center rounded-2xl border border-rule bg-card p-6 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-md"
            >
              <div class="grid h-11 w-11 place-items-center rounded-xl bg-brand/10 text-brand">
                <Icon name={s.icon} class="h-5 w-5" />
              </div>
              <h3 class="mt-5 text-lg font-semibold">{s.title}</h3>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand">
                {s.linkLabel}
                <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="container-px mx-auto max-w-6xl py-16 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight">Hi, I'm Scott.</h2>
      <p class="mt-6 text-lg leading-relaxed text-ink/80">
        I'm a REALTOR® with Keller Williams Metro. I was born in Royal Oak, grew up in Troy, and my wife and I are
        now proud homeowners back in Royal Oak. I help people buy, sell and rent across Metro Detroit, with straight answers and no pressure.
      </p>
      <a href="/my-story" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline">
        Read my story <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <!-- Reviews (hidden until reviews are added in src/data/site.ts) -->
  {
    reviews.length > 0 && (
      <section class="border-t border-rule bg-sand/60">
        <div class="container-px mx-auto grid max-w-6xl gap-6 py-16 sm:grid-cols-2 sm:py-20 lg:grid-cols-3">
          {reviews.map((r) => (
            <figure class="rounded-2xl bg-card p-6">
              <blockquote class="leading-relaxed text-ink/80">“{r.quote}”</blockquote>
              <figcaption class="mt-4 text-sm font-semibold">
                {r.name} <span class="font-normal text-muted">· {r.location}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <CtaBanner />
</Base>
