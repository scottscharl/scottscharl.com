---
import "../styles/global.css";

const phone = "+16025584553";
const phoneDisplay = "602-558-4553";
const email = "hello@scottscharl.com";
const facebook = "https://facebook.com/scottscharlrealtor";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scott Scharl — Keller Williams Realtor</title>
    <meta
      name="description"
      content="Scott Scharl — licensed Realtor with Keller Williams Metro in Royal Oak, MI."
    />
    <link rel="icon" type="image/png" href="/profile.png" />
  </head>
  <body
    class="min-h-screen bg-white text-gray-900 flex items-center justify-center p-6 antialiased"
  >
    <main class="w-full max-w-xs text-center">
      <img
        src="/profile.png"
        alt="Scott Scharl"
        width="128"
        height="128"
        class="mx-auto mb-6 h-32 w-32 rounded-full object-cover border-4 border-brand bg-gray-100"
      />

      <h1 class="text-2xl font-semibold tracking-tight leading-tight">
        Scott Scharl
      </h1>
      <p class="text-gray-500 text-sm mt-1">Realtor</p>
      <p class="text-brand text-sm font-semibold tracking-wider mt-1">
        KELLER WILLIAMS METRO
      </p>
      <p class="text-gray-500 text-sm">Royal Oak, MI</p>

      <nav class="mt-8 flex flex-col gap-3">
        <a
          href={`tel:${phone}`}
          aria-label={`Call ${phoneDisplay}`}
          class="flex items-center justify-center gap-2 w-full rounded-full border-2 border-brand bg-brand px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-dark hover:border-brand-dark transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          <span>Call</span>
        </a>

        <a
          href={`mailto:${email}`}
          aria-label={`Email ${email}`}
          class="flex items-center justify-center gap-2 w-full rounded-full border-2 border-brand bg-brand px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-dark hover:border-brand-dark transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>Email</span>
        </a>

        <a
          href={facebook}
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
          class="flex items-center justify-center gap-2 w-full rounded-full border-2 border-brand bg-white px-5 py-2.5 text-sm font-semibold text-brand hover:bg-red-50 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
            ></path>
          </svg>
          <span>Facebook</span>
        </a>
      </nav>
    </main>
  </body>
</html>
