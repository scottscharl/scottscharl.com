---
// TEMPORARY: bar for flipping between hero layout ideas. Remove once one is chosen.
interface Props {
  current: string;
}
const { current } = Astro.props;
const options = [
  { id: "current", href: "/", label: "Current" },
  { id: "a", href: "/try/a", label: "A · Split" },
  { id: "b", href: "/try/b", label: "B · In the neighborhood" },
  { id: "c", href: "/try/c", label: "C · Editorial" },
  { id: "d", href: "/try/d", label: "D · Profile card" },
  { id: "e", href: "/try/e", label: "E · Big portrait" },
];
---

<nav aria-label="Compare layouts (temporary)" class="relative z-[60] bg-ink text-white">
  <div class="flex items-center gap-2 overflow-x-auto px-4 py-2 text-sm">
    <span class="shrink-0 font-semibold text-white/70">Compare layouts:</span>
    {
      options.map((o) => (
        <a
          href={o.href}
          aria-current={o.id === current ? "page" : undefined}
          class:list={[
            "shrink-0 whitespace-nowrap rounded-full px-3 py-1 font-semibold transition-colors",
            o.id === current ? "bg-white text-ink" : "text-white hover:bg-white/15",
          ]}
        >
          {o.label}
        </a>
      ))
    }
  </div>
</nav>
