---
// D. Profile card: wide neighborhood banner, round headshot overlapping its bottom edge, words below.
import { Picture } from "astro:assets";
import HeroText from "./HeroText.astro";
import park from "../../assets/photos/neighborhood-park.jpg";
import { agent } from "../../data/site";
---

<section id="hero" class="pb-16 pt-6 md:pb-20 md:pt-28">
  <div class="container-px mx-auto max-w-6xl">
    <Picture
      src={park}
      formats={["avif", "webp"]}
      widths={[600, 900, 1200, 1800]}
      sizes="(min-width: 1152px) 1152px, 100vw"
      alt="Neighbors at Scott's food truck night in a Royal Oak pocket park"
      class="aspect-[4/3] w-full rounded-3xl object-cover md:aspect-[21/8]"
      pictureAttributes={{ class: "block" }}
      loading="eager"
    />
    <img
      src={agent.photo}
      alt={agent.name}
      class="relative mx-auto -mt-16 h-32 w-32 rounded-full bg-stone-100 object-cover shadow-xl shadow-black/20 md:-mt-20 md:h-40 md:w-40"
      width="160"
      height="160"
    />
    <div class="mt-6"><HeroText headshot={false} /></div>
  </div>
</section>
