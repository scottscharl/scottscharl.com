---
// The hero: a wide neighborhood banner with Scott's round headshot overlapping its
// bottom edge, then the headline, intro line and buttons. With a YouTube ID in
// src/data/site.ts, "Watch my story" opens the branding video in a full-screen player.
import { Picture } from "astro:assets";
import HeroText from "./HeroText.astro";
import park from "../assets/photos/neighborhood-park.jpg";
import { agent, heroVideo } from "../data/site";
---

<section id="hero" class="pb-16 pt-6 md:py-12">
  <div class="container-px mx-auto max-w-6xl">
    <Picture
      src={park}
      formats={["avif", "webp"]}
      widths={[600, 900, 1200, 1800]}
      sizes="(min-width: 1152px) 1152px, 100vw"
      alt="Neighbors at Scott's food truck night in a Royal Oak pocket park"
      class="aspect-[4/3] w-full rounded-3xl object-cover md:aspect-[21/8]"
      pictureAttributes={{ class: "block" }}
      loading="eager"
      fetchpriority="high"
    />
    <img
      src={agent.photo}
      alt={agent.name}
      class="relative mx-auto -mt-16 h-32 w-32 rounded-full bg-stone-100 object-cover shadow-xl shadow-black/20 md:-mt-20 md:h-40 md:w-40"
      width="160"
      height="160"
    />
    <div class="mt-6"><HeroText headshot={false} /></div>
  </div>
</section>

{heroVideo.youtubeId && (
  <dialog
    id="video-dialog"
    data-youtube-id={heroVideo.youtubeId}
    data-title={heroVideo.title}
    class="m-auto w-full max-w-5xl bg-transparent p-4 backdrop:bg-black/85"
  >
    <div
      class="relative aspect-video w-full overflow-hidden rounded-xl bg-black"
      id="video-frame"
    />
    <form method="dialog" class="mt-3 text-center">
      <button
        autofocus
        class="rounded-full bg-white/15 px-5 py-2 text-sm font-semibold text-white ring-1 ring-white/40"
      >
        Close
      </button>
    </form>
  </dialog>
)}

{heroVideo.youtubeId && <script>
  const dialog = document.getElementById("video-dialog") as HTMLDialogElement;
  const frame = document.getElementById("video-frame")!;
  document.getElementById("watch-video")?.addEventListener("click", () => {
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${dialog.dataset.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
    iframe.title = dialog.dataset.title ?? "Video";
    iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    iframe.allowFullscreen = true;
    iframe.className = "absolute inset-0 h-full w-full";
    frame.replaceChildren(iframe);
    dialog.showModal();
  });
  // Stop the video when the player closes (Close, Escape or tapping outside).
  dialog.addEventListener("close", () => frame.replaceChildren());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>}
