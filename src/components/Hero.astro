---
// The hero: full-width neighborhood photo with Scott's headshot, the tagline and
// the Contact button laid over it. A dark tint keeps the white text legible.
// When a YouTube ID is set in src/data/site.ts, a "Watch my story" button opens
// the branding video in a full-screen player (YouTube only loads on tap).
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import park from "../assets/photos/neighborhood-park.jpg";
import { agent, contactCta, heroVideo } from "../data/site";

const { youtubeId, title } = heroVideo;
---

<section id="hero" class="relative isolate flex min-h-[82svh] items-center overflow-hidden md:min-h-[78vh]">
  <Picture
    src={park}
    formats={["avif", "webp"]}
    widths={[600, 900, 1200, 1800]}
    sizes="100vw"
    alt=""
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    pictureAttributes={{ class: "contents" }}
    loading="eager"
    fetchpriority="high"
  />
  <!-- Tint: a light wash over the whole photo, plus a soft darker patch right behind the text so it stays legible. -->
  <div class="absolute inset-0 -z-10 bg-black/30" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_85%_46%_at_50%_62%,rgb(0_0_0/0.78),transparent)] md:bg-[radial-gradient(ellipse_50%_42%_at_50%_64%,rgb(0_0_0/0.68),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-px mx-auto w-full max-w-4xl py-16 text-center text-white">
    <img
      src={agent.photo}
      alt={agent.name}
      class="mx-auto h-28 w-28 rounded-full bg-stone-100 object-cover shadow-2xl shadow-black/40 sm:h-32 sm:w-32"
      width="128"
      height="128"
      fetchpriority="high"
    />
    <h1 class="mt-8 text-5xl font-semibold leading-[1.05] tracking-tight text-balance drop-shadow-md sm:text-7xl">
      {agent.tagline}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/90 drop-shadow sm:text-xl">
      Navigate today's real estate market with a trusted advisor.
    </p>
    <div class="mt-9 flex flex-col items-center gap-4">
      <a
        id="hero-cta"
        href={contactCta.href}
        class="rounded-full bg-brand px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-black/30 transition-colors hover:bg-brand-dark"
        >{contactCta.label}</a
      >
      {
        youtubeId ? (
          <button
            type="button"
            id="watch-video"
            class="inline-flex items-center gap-2 rounded-full bg-white/15 px-6 py-3.5 text-base font-semibold text-white ring-1 ring-white/40 backdrop-blur-sm transition-colors hover:bg-white/25"
          >
            <Icon name="play" class="h-4 w-4" />
            Watch my story
          </button>
        ) : (
          <a href={agent.sms} class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:underline">
            <Icon name="message" class="h-4 w-4" />
            Or text {agent.phoneDisplay}
          </a>
        )
      }
    </div>
  </div>
</section>

{
  youtubeId && (
    <dialog
      id="video-dialog"
      data-youtube-id={youtubeId}
      data-title={title}
      class="m-auto w-full max-w-5xl bg-transparent p-4 backdrop:bg-black/85"
    >
      <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black" id="video-frame" />
      <form method="dialog" class="mt-3 text-center">
        <button autofocus class="rounded-full bg-white/15 px-5 py-2 text-sm font-semibold text-white ring-1 ring-white/40">
          Close
        </button>
      </form>
    </dialog>
  )
}

{
  youtubeId && (
    <script>
      const dialog = document.getElementById("video-dialog") as HTMLDialogElement;
      const frame = document.getElementById("video-frame")!;
      document.getElementById("watch-video")?.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${dialog.dataset.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = dialog.dataset.title ?? "Video";
        iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        iframe.className = "absolute inset-0 h-full w-full";
        frame.replaceChildren(iframe);
        dialog.showModal();
      });
      // Stop the video when the player closes (Close, Escape or tapping outside).
      dialog.addEventListener("close", () => frame.replaceChildren());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    </script>
  )
}
