---
// The hero: headline and subline on the page background (most legible), then
// the big neighborhood photo at full brightness with only the Contact button
// (Scott's headshot inside it) and the text link on top. When a YouTube ID is
// set in src/data/site.ts, a "Watch my story" button opens the branding video
// in a full-screen player (YouTube only loads on tap).
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import park from "../assets/photos/neighborhood-park.jpg";
import { agent, contactCta, heroVideo } from "../data/site";

const { youtubeId, title } = heroVideo;
---

<section id="hero" class="pb-12 sm:pb-16">
  <div class="container-px mx-auto max-w-3xl pb-8 pt-12 text-center sm:pb-10 sm:pt-16">
    <h1 class="text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl">{agent.tagline}</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-muted sm:mt-5 sm:text-xl">
      Navigate today's real estate market with a trusted advisor.
    </p>
  </div>

  <div class="container-px mx-auto max-w-6xl">
    <div class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-xl shadow-black/10 sm:aspect-video">
      <Picture
        src={park}
        formats={["avif", "webp"]}
        widths={[600, 900, 1200, 1800]}
        sizes="(min-width: 1152px) 1152px, 100vw"
        alt="Neighbors gathered in a Royal Oak pocket park on a summer evening, with a food truck parked on the street"
        class="h-full w-full object-cover"
        pictureAttributes={{ class: "block h-full" }}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-x-0 bottom-0 flex flex-col items-center gap-3 p-6 sm:p-10">
        <a
          id="hero-cta"
          href={contactCta.href}
          class="inline-flex items-center gap-3 rounded-full bg-brand py-2 pl-2 pr-7 text-lg font-semibold text-white shadow-xl shadow-black/30 transition-colors hover:bg-brand-dark"
        >
          <img
            src={agent.photo}
            alt=""
            class="h-12 w-12 rounded-full bg-stone-100 object-cover"
            width="48"
            height="48"
            fetchpriority="high"
          />
          {contactCta.label}
        </a>
        {
          youtubeId ? (
            <button
              type="button"
              id="watch-video"
              class="inline-flex items-center gap-2 rounded-full bg-black/60 px-6 py-3 text-base font-semibold text-white shadow-lg transition-colors hover:bg-black/70"
            >
              <Icon name="play" class="h-4 w-4" />
              Watch my story
            </button>
          ) : (
            <a
              href={agent.sms}
              class="inline-flex items-center gap-2 rounded-full bg-black/60 px-4 py-2 text-sm font-semibold text-white shadow-lg hover:bg-black/70"
            >
              <Icon name="message" class="h-4 w-4" />
              Or text {agent.phoneDisplay}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

{
  youtubeId && (
    <dialog
      id="video-dialog"
      data-youtube-id={youtubeId}
      data-title={title}
      class="m-auto w-full max-w-5xl bg-transparent p-4 backdrop:bg-black/85"
    >
      <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black" id="video-frame" />
      <form method="dialog" class="mt-3 text-center">
        <button autofocus class="rounded-full bg-white/15 px-5 py-2 text-sm font-semibold text-white ring-1 ring-white/40">
          Close
        </button>
      </form>
    </dialog>
  )
}

{
  youtubeId && (
    <script>
      const dialog = document.getElementById("video-dialog") as HTMLDialogElement;
      const frame = document.getElementById("video-frame")!;
      document.getElementById("watch-video")?.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${dialog.dataset.youtubeId}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = dialog.dataset.title ?? "Video";
        iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        iframe.className = "absolute inset-0 h-full w-full";
        frame.replaceChildren(iframe);
        dialog.showModal();
      });
      // Stop the video when the player closes (Close, Escape or tapping outside).
      dialog.addEventListener("close", () => frame.replaceChildren());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    </script>
  )
}
