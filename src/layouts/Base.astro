---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import PumpkinfestBar from "../components/PumpkinfestBar.astro";
import { agent, contactCta, nav } from "../data/site";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: agent.name,
  telephone: agent.phoneDisplay,
  email: agent.email,
  url: Astro.site?.toString(),
  image: new URL(agent.photo, Astro.site).toString(),
  address: {
    "@type": "PostalAddress",
    streetAddress: agent.office.street,
    addressLocality: agent.office.city,
    addressRegion: agent.office.region,
    postalCode: agent.office.zip,
    addressCountry: "US",
  },
  sameAs: [agent.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(agent.photo, Astro.site)} />
    <link rel="icon" type="image/png" href="/profile.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
      >Skip to main content</a
    >

    <header class="site-header sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur-md">
      <div class="container-px mx-auto flex h-16 max-w-6xl items-center justify-between">
        <a href="/" class="flex items-center gap-3" aria-label={`${agent.name}, ${agent.brokerage} — home`}>
          <span class="whitespace-nowrap text-lg font-semibold tracking-tight">{agent.name}</span>
          <span class="h-6 w-px bg-rule" aria-hidden="true"></span>
          <img src="/kw-metro.png" alt="" class="h-7 w-auto" width="76" height="28" />
        </a>

        <nav class="hidden items-center gap-6 md:flex lg:gap-8" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
                class="whitespace-nowrap text-sm font-medium text-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={contactCta.href}
            class="whitespace-nowrap rounded-full bg-brand px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
            >{contactCta.label}</a
          >
        </nav>

        <button
          type="button"
          id="menu-toggle"
          class="inline-flex h-10 w-10 items-center justify-center md:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="h-5 w-5" />
        </button>
      </div>

      <nav id="mobile-menu" class="hidden border-t border-rule md:hidden" aria-label="Mobile">
        <div class="container-px flex flex-col py-2">
          {
            [...nav, contactCta].map((item) => (
              <a href={item.href} class="whitespace-nowrap py-3 text-base font-medium">
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <PumpkinfestBar />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div class="container-px mx-auto max-w-6xl space-y-2 py-10 text-center text-xs leading-relaxed text-muted">
        <img src="/kw-metro.png" alt={agent.brokerage} class="mx-auto mb-4 h-10 w-auto" width="108" height="40" loading="lazy" />
        <p class="text-sm font-semibold text-ink">{agent.name} · {agent.title}</p>
        <p>
          {agent.office.street}, {agent.office.city}, {agent.office.region} {agent.office.zip}
          {agent.license && ` · Michigan License #${agent.license}`}
        </p>
        <p>
          © {year} {agent.name}. Equal Housing Opportunity. Each Keller Williams office is independently owned and
          operated.
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
        menu?.classList.toggle("hidden", open);
      });
    </script>
  </body>
</html>
