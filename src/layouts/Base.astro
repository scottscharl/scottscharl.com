---
import "../styles/global.css";
import { agent, contactCta } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Keep a page out of search results (e.g. temporary test pages). */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: agent.name,
  telephone: agent.phoneDisplay,
  email: agent.email,
  url: Astro.site?.toString(),
  image: new URL(agent.photo, Astro.site).toString(),
  address: {
    "@type": "PostalAddress",
    streetAddress: agent.office.street,
    addressLocality: agent.office.city,
    addressRegion: agent.office.region,
    postalCode: agent.office.zip,
    addressCountry: "US",
  },
  sameAs: [agent.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(agent.photo, Astro.site)} />
    <link rel="icon" type="image/jpeg" href="/headshot.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
      >Skip to main content</a
    >

    <!-- Hidden while the hero photo is on screen; slides in as a solid white bar once you scroll past it. -->
    <header
      id="site-header"
      class="fixed inset-x-0 top-0 z-50 -translate-y-full border-b border-rule bg-white transition-transform duration-300"
      inert
    >
      <div class="container-px mx-auto flex h-16 max-w-6xl items-center justify-between">
        <a href="/" class="flex items-center gap-3" aria-label={`${agent.name}, ${agent.brokerage} — home`}>
          <img
            src={agent.photo}
            alt=""
            class="h-10 w-10 rounded-full bg-stone-100 object-cover"
            width="40"
            height="40"
          />
          <span class="whitespace-nowrap text-lg font-semibold tracking-tight">{agent.name}</span>
          <span class="h-6 w-px bg-rule" aria-hidden="true"></span>
          <img src="/kw-metro.png" alt="" class="h-7 w-auto" width="76" height="28" />
        </a>
        <a
          href={contactCta.href}
          class="hidden whitespace-nowrap rounded-full bg-brand px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-dark sm:inline-flex"
          >{contactCta.label}</a
        >
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-rule pb-20 sm:pb-0">
      <div class="container-px mx-auto max-w-6xl space-y-2 py-10 text-center text-xs leading-relaxed text-muted">
        <img src="/kw-metro.png" alt={agent.brokerage} class="mx-auto mb-4 h-10 w-auto" width="108" height="40" loading="lazy" />
        <p class="text-sm font-semibold text-ink">{agent.name} · {agent.title}</p>
        <p>
          {agent.office.street}, {agent.office.city}, {agent.office.region} {agent.office.zip}
          {agent.license && ` · Michigan License #${agent.license}`}
        </p>
        <p>
          © {year} {agent.name}. Equal Housing Opportunity. Each Keller Williams office is independently owned and
          operated.
        </p>
      </div>
    </footer>
    <script>
      // Show the header only once the hero (#hero) has scrolled out of view.
      // Pages without a hero show it all the time.
      const header = document.getElementById("site-header")!;
      const show = (visible: boolean) => {
        header.classList.toggle("-translate-y-full", !visible);
        header.inert = !visible;
      };
      const hero = document.getElementById("hero");
      if (hero) new IntersectionObserver(([entry]) => show(!entry.isIntersecting)).observe(hero);
      else show(true);
    </script>
  </body>
</html>
